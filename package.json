    "food:audit": "node scripts/audit-food-data.mjs --write docs/FOOD_DATA_COVERAGE.md"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "6.5.438",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "^6.0.3",
    "vite": "7.3.7",
    "vue-tsc": "^3.3.14"
  }
}
