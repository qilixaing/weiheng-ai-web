{
  "name": "vitabalance-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/local-start.mjs",
    "dev": "vite --configLoader native --host 127.0.0.1 --port 5173",
    "build": "vite build --configLoader native",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
